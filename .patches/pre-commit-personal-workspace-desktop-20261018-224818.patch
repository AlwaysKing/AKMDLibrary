++import type { Highlighter } from 'shiki';
++import { getCodeThemeRegistration, type CodeThemeValue } from '../../utils/codeTheme';
++import { LANGUAGES } from './languages';
++
++const SHIKI_LANG_IDS = LANGUAGES.map(([id]) => id).filter((id) => id !== 'text');
