++    // Shiki may omit trailing empty lines. Keep the overlay line count aligned
++    // with the editable text so newlines render at the correct height.
++    while (lines.length < plainLines.length) lines.push('');
++    return lines;
++  } catch {
++    return plainLines;
++  }
++}
